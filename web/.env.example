# ---------------------------------------------------------------------------
# Unfurl web environment
# Copy to .env and fill in. Every value is intentionally empty.
#
# The browser NEVER talks to the api/ service directly and never sees the
# session token: every call goes through this app's own /api/* route handlers,
# which attach the token from an httpOnly cookie. That is why there is no
# NEXT_PUBLIC_* API URL here.
# ---------------------------------------------------------------------------

# Base URL of the api/ service, as reached from the Next.js server.
# Local (api run with npm run start:dev):  http://localhost:3001
# Local (api run via docker compose):      http://localhost:3001
# Inside docker compose network:           http://api:3001
API_BASE_URL=

# Name of the httpOnly cookie holding the session token (default: unfurl_session)
SESSION_COOKIE_NAME=

# Set to "true" to mark the session cookie Secure. Leave empty for plain-http
# local development, or the browser will silently drop the cookie.
COOKIE_SECURE=
