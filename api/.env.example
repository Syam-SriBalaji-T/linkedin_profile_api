# ---------------------------------------------------------------------------
# Unfurl API environment
# Copy to .env and fill in. Every value is intentionally empty.
# ---------------------------------------------------------------------------

# Runtime environment: development | production
NODE_ENV=

# Port the NestJS HTTP server listens on (default 3001)
PORT=

# Log verbosity: error | warn | log | debug | verbose
LOG_LEVEL=

# --- database --------------------------------------------------------------

# Postgres connection string, used by the API, the worker and the migrations.
# Managed Postgres (Neon/Supabase/RDS) needs TLS, e.g.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local docker compose Postgres:
#   postgres://unfurl:unfurl@localhost:5432/unfurl
DATABASE_URL=

# Direct (non-pooled) connection string, used ONLY by the Prisma CLI
# (db:pull / db:diff / db:studio). On Neon this is the same host without
# "-pooler". Leave blank when DATABASE_URL is already a direct connection.
DIRECT_DATABASE_URL=

# Max connections in the pg pool per process (default 10). Keep this small
# behind a connection pooler such as Neon's -pooler endpoint.
DATABASE_POOL_MAX=

# --- app auth --------------------------------------------------------------

# How long a login session stays valid, in hours (default 24)
SESSION_TTL_HOURS=

# NOTE: there is no CORS variable. The browser allowlist is database-driven —
# see the cors_origins table (migration 002).

# --- linkedin session ------------------------------------------------------

# Preferred: the FULL cookie header from a logged-in linkedin.com request
# (DevTools > Network > any www.linkedin.com request > Request Headers > Cookie).
# Profile-data endpoints reject a bare li_at; they need the whole jar (lidc,
# bcookie, ...). If set, this takes precedence over LINKEDIN_LI_AT below.
LINKEDIN_COOKIE=

# Minimal fallback: just the "li_at" session cookie
LINKEDIN_LI_AT=

# LinkedIn CSRF token; must equal the JSESSIONID cookie value paired with li_at
LINKEDIN_CSRF_TOKEN=

# User-Agent string sent with LinkedIn requests (has a sane default)
LINKEDIN_USER_AGENT=

# Timeout for a single upstream profile fetch, in ms (default 20000)
# Minimum gap between LinkedIn requests in ms, to avoid soft-blocking (default 4000)
LINKEDIN_MIN_REQUEST_INTERVAL_MS=

FETCH_TIMEOUT_MS=

# --- cache and jobs --------------------------------------------------------

# How long a cached profile stays fresh before a refetch, in hours (default 24)
PROFILE_CACHE_TTL_HOURS=

# How many times a failed job is retried before it is marked failed (default 3)
JOB_MAX_ATTEMPTS=

# How long the worker sleeps when the queue is empty, in ms (default 2000)
WORKER_POLL_INTERVAL_MS=

# How many jobs one worker process handles in parallel (default 1)
WORKER_CONCURRENCY=

# true = the API process also runs the job worker (one command for local dev);
# leave blank/false and run the worker separately in production
RUN_WORKER_IN_API=

# A running job older than this is treated as abandoned and re-queued, in ms (default 300000)
JOB_STUCK_AFTER_MS=
