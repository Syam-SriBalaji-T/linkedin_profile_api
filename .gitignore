# ---- secrets ----------------------------------------------------------------
# Ignore env files at every depth (api/.env, web/.env, ./.env, ...)
.env
.env.*
# ...but keep the committed templates tracked.
!.env.example
!.env.*.example

# ---- dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*

# ---- build output -----------------------------------------------------------
dist/
dist-scripts/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ---- caches / tooling -------------------------------------------------------
.eslintcache
.cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/

# ---- editors / OS -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Browser captures / cookie dumps at the repo root (1.json, 2.json, 3.json, ...)
# — never commit. Config JSON under api/ and web/ stays tracked (not at root).
/*.json
*.cookies
# temp scratch scripts
_*.cjs
_*.html
